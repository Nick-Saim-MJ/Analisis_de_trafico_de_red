# Datasets de origen (grandes, se copian/descargan por fuera, no se versionan)
pyspark/sesiones/*/data/
pyspark/sesiones/*/data_backup*/

# Salidas generadas al correr los notebooks (Parquet/CSV/JSON escritos por cada sesión)
pyspark/sesiones/*/artifacts/

# Jupyter
.ipynb_checkpoints/

# Carpeta de trabajo/pruebas personal, no es material de la sesión
pyspark/sesiones/env/

# Trash del contenedor (aparece si se borra un archivo desde dentro de Docker)
.Trash-0/

# Python
__pycache__/
*.pyc

# SO
.DS_Store
